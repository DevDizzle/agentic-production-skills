{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./typescript/src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["typescript/src/**/*.ts"]
}
