{
  "name": "agentic-production-skills",
  "version": "1.0.0",
  "description": "Zero-dependency production architectural patterns and installable AI coding skills for reliable, auditable, and resilient agent systems.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Evan Parra",
    "url": "https://evanparra.ai"
  },
  "homepage": "https://evanparra.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDizzle/agentic-production-skills.git"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "typescript/src",
    "skills",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./coordination": {
      "types": "./dist/coordination.d.ts",
      "default": "./dist/coordination.js"
    },
    "./compliance": {
      "types": "./dist/compliance.d.ts",
      "default": "./dist/compliance.js"
    },
    "./resilience": {
      "types": "./dist/resilience.d.ts",
      "default": "./dist/resilience.js"
    }
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "npm run test:py && npm run test:ts",
    "test:ts": "node --experimental-strip-types --test tests/typescript/patterns.test.ts",
    "test:py": "PYTHONPATH=python python3 -m unittest discover -s tests/python -v",
    "typecheck": "npx --yes -p typescript@5.8.2 tsc -p tsconfig.json",
    "build": "npx --yes -p typescript@5.8.2 tsc -p tsconfig.build.json"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "claude-code",
    "antigravity",
    "cursor",
    "codex",
    "guardrails",
    "multi-agent",
    "typescript",
    "python"
  ]
}
